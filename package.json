{
  "name": "tx-cpi-invoker",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "anchor-build": "cd anchor && anchor build",
    "anchor-test": "cd anchor && anchor test --skip-deploy",
    "anchor-test-ts": "cd anchor && npm run test",
    "codama:js": "codama run js",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:preview": "npm --prefix apps/web run preview",
    "web:check": "npm --prefix apps/web run check",
    "keeper:dev": "npm --prefix services/keeper run dev",
    "keeper:build": "npm --prefix services/keeper run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run web:build && npm run web:check && npm run format:check",
    "setup": "npm run anchor-build && npm run codama:js",
    "dev": "npm run web:dev",
    "build": "npm run web:build",
    "start": "npm run web:preview",
    "check": "npm run web:check"
  },
  "description": "Trigger-based Solana CPI executor (Anchor program + order keeper + frontend)",
  "version": "0.0.0",
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.3.8",
    "@codama/renderers-js": "^1.5.5",
    "codama": "^1.5.0",
    "prettier": "^3.6.2"
  }
}
